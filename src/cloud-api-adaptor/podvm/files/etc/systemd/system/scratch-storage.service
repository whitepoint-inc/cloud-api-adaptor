[Unit]
Description=Configurable Scratch Storage Setup for Kata Agent
After=systemd-repart.service
# fort-ai fork: order after the bind mount of /run/kata-containers so it can never shadow the
# image/ and shared/ mounts made beneath it. Ordering ONLY: on the Ubuntu podvm that mount
# fails on every attempt (kata-agent just mkdir -p's /run/kata-containers on the /run tmpfs),
# and a Requires=/RequiresMountsFor= on it skipped this unit with "Dependency failed".
After=run-kata\x2dcontainers.mount
# It must complete before the kata-agent starts
Before=kata-agent.service
DefaultDependencies=no
ConditionPathExists=/run/peerpod/scratch-space.marker

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/bin/setup-scratch-storage

[Install]
WantedBy=multi-user.target

[Unit]
Description=Configurable Scratch Storage Setup for Kata Agent
After=systemd-repart.service
# fort-ai fork: the bind mount of /run/kata-containers (run-kata\x2dcontainers.mount) must be in
# place first, or it would shadow the image/ and shared/ mounts this unit creates beneath it.
RequiresMountsFor=/run/kata-containers
# It must complete before the kata-agent starts
Before=kata-agent.service
DefaultDependencies=no
ConditionPathExists=/run/peerpod/scratch-space.marker

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/bin/setup-scratch-storage

[Install]
WantedBy=multi-user.target
